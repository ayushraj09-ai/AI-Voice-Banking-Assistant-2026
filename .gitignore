# NOTE: git does not support comments after a pattern, so every comment is on its own line.

# dependencies / environments (regenerated by npm install and ml/setup_windows.ps1)
node_modules/
.venv/
ml/.venv/
__pycache__/
*.pyc

# secrets and private data - NEVER commit
.env
.session-secret

# database, password/PIN hashes, enrolled voice profiles, voice recordings
data/

# recordings of real people (biometric data, needs consent)
samples/
*.wav
*.flac
*.tar.gz

# speaker-name mapping made by paper_export.py
*PRIVATE*

# large / regenerable
# pretrained ECAPA model: downloaded automatically on first start
ml/models/
pretrained_models/
logs/
*.log
# generated by MAKE_REPORT.bat
reports/
test_speaker_accuracy_old/
eval/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
